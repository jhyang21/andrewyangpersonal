.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# The real Final Shift roster: coworkers' actual Ape Coffee clock-in codes and Andrew's private
# notes to named people. Git history is forever and recoverable after deletion, so one accidental
# commit is a permanent disclosure. Only roster.sample.json — entirely invented — is committed.
content/final-shift/*.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

